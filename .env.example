# Partnership enquiry form.
#
# Copy to .dev.vars for local `wrangler pages dev`, or set these in the
# Cloudflare Pages project under Settings > Environment variables.
# Never commit real values: .env and .dev.vars are both gitignored.

# --- Server-only. Set as ENCRYPTED variables in Cloudflare Pages. -------

# Resend API key. https://resend.com/api-keys
# Sending-only permission is enough.
RESEND_API_KEY=

# Where enquiries are delivered.
ENQUIRY_TO=info@swtelite.com

# The From address. Its domain must be verified in Resend first, or
# Resend rejects the send. Something like:
#   SWT Elite <enquiries@swtelite.com>
ENQUIRY_FROM=

# Turnstile secret key. https://dash.cloudflare.com > Turnstile
# If this is unset the Function skips verification entirely, so the form
# still works, unprotected.
TURNSTILE_SECRET_KEY=

# --- Public. Compiled into the client bundle by design. ----------------

# Turnstile site key. Site keys are public; this is not a secret.
# If unset the widget renders nothing and no token is sent.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
